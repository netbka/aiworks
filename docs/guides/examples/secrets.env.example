# AIWorks secrets. Copy to .local/supervisor/.env and fill in the values.
# This file never goes into Git, and AIWorks never loads it into its environment:
# it reads one value at the moment it needs it, and agents never see it.
#
# The name of each line is the reference from config.json, uppercased,
# with every other character turned into "_":
#   aiworks-alerts/bot  ->  AIWORKS_ALERTS_BOT

# Telegram alerts (plugin "Telegram alerts")
AIWORKS_ALERTS_BOT=
AIWORKS_ALERTS_CHAT=

# Sign-in to a web system for browser work (plugin "Sign-in to web systems")
EXAMPLE_CRM_USER=
EXAMPLE_CRM_PASSWORD=

# Tasks through the API: "campaign-token create" writes its line here by itself.
