{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiworks.local/schemas/worker-task-packet.schema.json",
  "title": "Scoped worker task packet",
  "description": "Transient sanitized packet with revision-pinned repository pointers. validatePacket additionally enforces policy byte/reference limits; planContext requires all non-implementer roles to be read-only. Schema is not a DLP or authorization service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenantId", "projectId", "environment", "taskId", "stageId", "runId", "role", "revision", "authorityDigest", "access", "goal", "constraints", "acceptance", "references"],
  "properties": {
    "version": { "const": 1 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "environment": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "stageId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "role": { "enum": ["implementer", "verification", "security-review", "browser-review"] },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "authorityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "access": { "enum": ["read-only", "write"] },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "constraints": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }
    },
    "acceptance": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }
    },
    "references": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "revision"],
        "properties": {
          "path": {
            "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S",
            "allOf": [
              { "not": { "pattern": "(^/)|[\\\\:%\\u0000-\\u001f\\u007f]" } },
              { "not": { "pattern": "(^|/)\\.\\.?(/|$)|//|/$" } }
            ]
          },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "governance": {
      "description": "Optional. The target project's inherited governance as values only: its registry id, the inherited portfolio policy IDs, its declared authority pointers (repository-relative paths in the target repository) and its declared exceptions and gaps as id and rule. Never summaries, sources, approvals or file contents. Packets recorded without it remain valid.",
      "type": "object", "additionalProperties": false,
      "required": ["project", "policies", "authorities", "exceptions", "gaps"],
      "properties": {
        "project": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "policies": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": { "type": "string", "maxLength": 160, "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" }
        },
        "authorities": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["role", "path"],
            "properties": {
              "role": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
              "path": {
                "type": "string", "maxLength": 512, "pattern": "^(?!(?:[^#]*/)?\\.{1,2}(?:[/#]|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?:#[A-Za-z0-9._-]+)?$",
                "not": { "$comment": "Secret-like path: SECRET_LIKE_PATH_PATTERN in scripts/lib/worker-context.mjs, identical in the project contract's projectPath.", "pattern": "(?:^|/)(?:\\.[Ee][Nn][Vv][^/#]*|[^/#]+\\.[Ee][Nn][Vv]|\\.[Gg][Ii][Tt]|\\.[Ss][Ss][Hh]|\\.[Gg][Nn][Uu][Pp][Gg]|\\.[Nn][Pp][Mm][Rr][Cc]|\\.[Nn][Ee][Tt][Rr][Cc]|\\.[Gg][Ii][Tt]-[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|\\.[Kk][Uu][Bb][Ee]/[Cc][Oo][Nn][Ff][Ii][Gg]|[Ii][Dd]_[Rr][Ss][Aa][^/#]*|[Ii][Dd]_[Ee][Dd]25519[^/#]*|[Ii][Dd]_[Ee][Cc][Dd][Ss][Aa][^/#]*|[^/#]*\\.[Tt][Ff][Ss][Tt][Aa][Tt][Ee](?:\\.[^/#]*)?|[^/#]*\\.[Tt][Ff][Vv][Aa][Rr][Ss](?:\\.[Jj][Ss][Oo][Nn])?|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?(?:\\.[^/#]*)?|[Ss][Ee][Cc][Rr][Ee][Tt][Ss]?(?:\\.[^/#]*)?)(?:[/#]|$)|\\.(?:[Pp][Ee][Mm]|[Kk][Ee][Yy]|[Pp]12|[Pp][Ff][Xx]|[Jj][Kk][Ss]|[Kk][Ee][Yy][Ss][Tt][Oo][Rr][Ee]|[Cc][Rr][Tt]|[Cc][Ee][Rr]|[Dd][Ee][Rr]|[Pp][Pp][Kk])(?:#|$)" }
              }
            }
          }
        },
        "exceptions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/declaredRule" } },
        "gaps": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/declaredRule" } }
      }
    }
  },
  "definitions": {
    "declaredRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "rule": { "type": "string", "maxLength": 160, "pattern": "^(?:constitution#(?:[1-9]|1[0-8])|baseline:[a-z][a-z0-9-]*|policy:[A-Z][A-Z0-9]*-[0-9]{3}#[a-z][a-z0-9-]*)$" }
      }
    }
  }
}
