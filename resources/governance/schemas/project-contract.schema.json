{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWorks standalone project registration",
  "type": "object",
  "required": ["id", "name", "repository", "lifecycle", "capabilities", "environments", "governance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "repository": {
      "type": "object", "required": ["github"],
      "properties": { "github": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" } },
      "additionalProperties": false
    },
    "lifecycle": { "enum": ["active", "experimental", "parked", "archived"] },
    "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "environments": { "type": "array", "uniqueItems": true, "items": { "enum": ["local", "dev", "staging", "prod"] } },
    "governance": {
      "type": "object", "required": ["authorities", "independentVerificationGate"],
      "properties": {
        "authorities": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "required": ["role", "path"],
            "properties": {
              "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
              "path": {
                "$comment": "Relative to the project repository root, optional #anchor, never a secret-like path. The `not` pattern is SECRET_LIKE_PATH_PATTERN in scripts/lib/worker-context.mjs, identical in the worker packet schema.",
                "type": "string", "minLength": 1, "maxLength": 512,
                "pattern": "^(?!(?:[^#]*/)?\\.{1,2}(?:[/#]|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?:#[A-Za-z0-9._-]+)?$",
                "not": { "pattern": "(?:^|/)(?:\\.[Ee][Nn][Vv][^/#]*|[^/#]+\\.[Ee][Nn][Vv]|\\.[Gg][Ii][Tt]|\\.[Ss][Ss][Hh]|\\.[Gg][Nn][Uu][Pp][Gg]|\\.[Nn][Pp][Mm][Rr][Cc]|\\.[Nn][Ee][Tt][Rr][Cc]|\\.[Gg][Ii][Tt]-[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|\\.[Kk][Uu][Bb][Ee]/[Cc][Oo][Nn][Ff][Ii][Gg]|[Ii][Dd]_[Rr][Ss][Aa][^/#]*|[Ii][Dd]_[Ee][Dd]25519[^/#]*|[Ii][Dd]_[Ee][Cc][Dd][Ss][Aa][^/#]*|[^/#]*\\.[Tt][Ff][Ss][Tt][Aa][Tt][Ee](?:\\.[^/#]*)?|[^/#]*\\.[Tt][Ff][Vv][Aa][Rr][Ss](?:\\.[Jj][Ss][Oo][Nn])?|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?(?:\\.[^/#]*)?|[Ss][Ee][Cc][Rr][Ee][Tt][Ss]?(?:\\.[^/#]*)?)(?:[/#]|$)|\\.(?:[Pp][Ee][Mm]|[Kk][Ee][Yy]|[Pp]12|[Pp][Ff][Xx]|[Jj][Kk][Ss]|[Kk][Ee][Yy][Ss][Tt][Oo][Rr][Ee]|[Cc][Rr][Tt]|[Cc][Ee][Rr]|[Dd][Ee][Rr]|[Pp][Pp][Kk])(?:#|$)" }
              }
            },
            "additionalProperties": false
          }
        },
        "independentVerificationGate": { "const": "enabled" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
